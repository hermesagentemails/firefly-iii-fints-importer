{
  "name": "firefly-iii-fints-importer-frontend-modernization",
  "version": "1.0.0",
  "description": "Modern frontend rebuild for Firefly III FinTS importer with Bootstrap 5, SCSS, and modern tooling",
  "private": true,
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 8080 --open",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint assets/**/*.{js,scss} --fix",
    "format": "prettier --write assets/** --ignore-pattern 'node_modules/**/*'"
  },
  "keywords": [
    "bootstrap",
    "scss",
    "vite",
    "modern-frontend",
    "firefly-iii"
  ],
  "dependencies": {
    "bootstrap": "^5.3.0",
    "bootstrap-icons": "^1.11.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@vitejs/plugin-react": "^3.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-html": "^8.0.0",
    "prettier": "^3.0.0",
    "vite": "^4.0.0",
    "vite-plugin-eslint": "^3.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}