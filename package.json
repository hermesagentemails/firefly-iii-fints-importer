{
  "name": "firefly-iii-fints-importer",
  "version": "1.0.0",
  "description": "Modern frontend rebuild for Firefly III FinTS Importer with Bootstrap 5, Vite dev workflow, and Docker setup",
  "private": true,
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 8080",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint assets/**/*.{js,scss} --fix",
    "format": "prettier --write assets/** --ignore-pattern 'node_modules/**/*'"
  },
  "keywords": [
    "bootstrap",
    "scss",
    "vite",
    "modern-frontend",
    "firefly-iii"
  ],
  "dependencies": {
    "bootstrap": "^5.3.2",
    "bootstrap-icons": "^1.11.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-html": "^8.0.0",
    "vite": "^6.4.2",
    "vite-plugin-eslint": "^1.8.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}