{% extends 'base.twig' %}

{% block title %}Choose Account{% endblock %}

{% block content %}
    <div class="card">
        <div class="card-header">
            <h2 class="h5 mb-0">
                <i class="bi bi-folder-fill me-2"></i>
                Choose Bank Account
            </h2>
        </div>
        <div class="card-body">
            {% if bank_accounts|length == 0 %}
                <div class="alert alert-warning" role="alert">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    No bank accounts configured yet.
                    <a href="/" class="text-primary">
                        <i class="bi bi-arrow-up-circle-fill me-1"></i>Back to start
                    </a>
                </div>
            {% elif bank_accounts|length > 0 %}
                <div class="mb-4">
                    <h5 class="h6 mb-2">
                        <i class="bi bi-credit-card me-1"></i>
                        Your Bank Accounts
                    </h5>
                    <div class="list-group">
                        {% for index, account in bank_accounts %}
                            <a href="#" class="list-group-item list-group-item-action {% if loop.first %}active{% endif %}" data-index="{{ index }}">
                                <div class="d-flex w-100 justify-content-between">
                                    <h6 class="mb-1">
                                        <strong>{{ account.getSubAccount() }}</strong>
                                    </h6>
                                    <small class="text-muted">
                                        {{ account.getAccountNumber() }}
                                    </small>
                                </div>
                            </a>
                        {% endfor %}
                    </div>
                    <input type="hidden" name="bank_account" id="bank_account" value="{{ bank_accounts|first|index }}" />
                </div>
            {% endif %}

            <form name="next-form" action="." method="post" id="accountForm">
                <input type="hidden" name="step" value="{{ next_step }}">
                
                <div class="mb-4">
                    <label for="bank_account" class="form-label">
                        <i class="bi bi-folder-fill me-1"></i>
                        Bank Account
                    </label>
                    <select class="form-select" id="bank_account" name="bank_account" required>
                        {% for index, account in bank_accounts %}
                            <option value="{{ index }}" {% if account.id == bank_accounts|first|index %}selected{% endif %}>
                                <span>{{ account.getSubAccount() }}</span>
                                {{ account.getAccountNumber() }}
                            </option>
                        {% endfor %}
                    </select>
                </div>

                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-arrow-right-circle me-1"></i>
                    Proceed to next step
                </button>
            </form>
        </div>
    </div>
{% endblock %}

{% block extra_js %}
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const accountSelect = document.getElementById('bank_account');
        const nextStep = document.getElementById('next-step');
        
        if (accountSelect && nextStep) {
            accountSelect.addEventListener('change', function() {
                nextStep.textContent = 'Proceed to next step';
            });
        }
    });
</script>
{% endblock %}