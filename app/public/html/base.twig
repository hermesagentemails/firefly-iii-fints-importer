<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Firefly III FinTS Importer - Modernized">
    <title>{% block title %}{% endblock %} - Firefly III FinTS Importer</title>

    <!-- Favicon -->
    <link rel="icon" href="data:,">

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet"
          integrity="sha-bs5-IntegrityHash" crossorigin="anonymous">

    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet">

    <!-- Custom CSS -->
    <style>
        :root {
            --bs-primary: #0d6efd;
            --bs-primary-rgb: 13, 110, 253;
            --bs-secondary: #6c757d;
            --bs-success: #28a745;
            --bs-info: #17a2b8;
            --bs-warning: #ffc107;
            --bs-danger: #dc3545;
            --bs-light: #f8f9fa;
            --bs-dark: #343a40;
        }

        body {
            min-height: 100vh;
            background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
        }

        .container {
            max-width: 800px;
            margin: 2rem auto;
        }

        .card {
            border-radius: 0.75rem;
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.1);
            border: none;
        }

        .card-header {
            background: linear-gradient(135deg, var(--bs-primary) 0%, #0a58ca 100%);
            color: white;
            border-radius: 0.75rem 0.75rem 0 0 !important;
        }

        .btn-primary {
            background: linear-gradient(135deg, var(--bs-primary) 0%, #0a58ca 100%);
            border: none;
            transition: transform 0.15s ease, box-shadow 0.15s ease;
        }

        .btn-primary:hover {
            transform: translateY(-1px);
            box-shadow: 0 0.25rem 0.5rem rgba(13, 110, 253, 0.25);
        }

        .form-control:focus, .form-select:focus {
            border-color: var(--bs-primary);
            box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25);
        }

        .progress {
            height: 1.5rem;
            border-radius: 0.5rem;
            overflow: hidden;
        }

        .list-unstyled > li {
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

        .list-unstyled > li:hover {
            transform: translateX(4px);
        }

        .alert {
            border-radius: 0.5rem;
            border: none;
        }

        .text-monospace {
            font-family: "Courier New", Courier, monospace;
        }
    </style>

    {% block extra_css %}{% endblock %}
</head>
<body>
    <header class="mb-4">
        <div class="container text-center">
            <h1 class="h4 mb-0 text-primary">
                <i class="bi bi-bank2 me-2"></i>
                Firefly III FinTS Importer
            </h1>
        </div>
    </header>

    <main class="container">
        {% block content %}{% endblock %}
    </main>

    <footer class="container mt-5 pt-4 border-top text-center text-muted small">
        <p class="mb-0">
            <a href="https://github.com/firefly-iii-importer/fints-importer"
               class="text-muted text-decoration-none" target="_blank" rel="noopener">
                <i class="bi bi-github me-1"></i>Open Source
            </a>
            &middot; Built with <i class="bi bi-heart-fill text-danger"></i> for Firefly III
        </p>
    </footer>

    <!-- Bootstrap 5 Bundle with Popper -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"
            integrity="sha-bs5-IntegrityHash" crossorigin="anonymous"></script>

    <!-- Modern JavaScript -->
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Auto-submit forms with proper error handling
            const autoSubmitForms = document.querySelectorAll('[data-auto-submit]');
            autoSubmitForms.forEach(form => {
                const delay = parseInt(form.dataset.delay) || 2000;
                setTimeout(() => {
                    if (!form.querySelector('button[type=submit]').disabled) {
                        form.querySelector('button[type=submit]').click();
                    }
                }, delay);
            });

            // Enable tooltips and popovers
            const tooltipTriggerList = [].slice.call(
                document.querySelectorAll('[data-bs-toggle="tooltip"]')
            );
            if (window.bootstrap && tooltipTriggerList.length) {
                tooltipTriggerList.map(el => new bootstrap.Tooltip(el));
            }
        });
    </script>

    {% block extra_js %}{% endblock %}
</body>
</html>