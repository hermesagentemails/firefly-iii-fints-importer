{% extends 'base.twig' %}

{% block title %}Choose Configuration{% endblock %}

{% block content %}
    <div class="card">
        <div class="card-header">
            <h2 class="h5 mb-0">
                <i class="bi bi-gear-fill me-2"></i>
                Enter account data
            </h2>
        </div>
        <div class="card-body">
            {% if requested_config_file is not empty %}
                <div class="alert alert-info" role="alert">
                    <i class="bi bi-info-circle me-2"></i>
                    A specific config file has been requested via URL parameter.
                </div>
                
                {{ macros.skip_form() }}
            {% endif %}

            {% if configuration is not empty %}
                <div class="alert alert-warning" role="alert">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    Configuration already loaded: {{ configuration.name }}
                </div>
            {% endif %}

            <form name="next-form" action="." method="post" id="configForm">
                <input type="hidden" name="step" value="{{ next_step }}">
                
                <div class="mb-4">
                    <label for="data_collect_mode" class="form-label">
                        <i class="bi bi-folder-fill me-1"></i>
                        Configuration
                    </label>
                    <select class="form-select" id="data_collect_mode" name="data_collect_mode" required>
                        {% if requested_config_file is empty %}
                            {% for file in files %}
                                <option value="{{ file }}">{{ file }}</option>
                            {% endfor %}
                            <option value="createNewDataset" class="text-end">
                                <span>✨</span> Create new configuration
                            </option>
                        {% else %}
                            <option value="{{ requested_config_file }}" selected>
                                {{ requested_config_file }}
                            </option>
                        {% endif %}
                    </select>
                    {% if requested_config_file is empty %}
                        <div class="form-text">
                            Choose a method to configure the importer.
                            You can either select a configuration file or create a new one.
                        </div>
                    {% endif %}
                </div>

                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-arrow-right-circle me-1"></i>
                    Continue
                </button>
            </form>
        </div>
    </div>
{% endblock %}