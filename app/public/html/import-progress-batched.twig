{% extends 'base.twig' %}

{% block title %}Import in Progress{% endblock %}

{% block content %}
    <div class="card">
        <div class="card-header">
            <h2 class="h5 mb-0">
                <i class="bi bi-hourglass-split me-2"></i>
                Import in Progress...
            </h2>
        </div>
        <div class="card-body">
            <div class="mb-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h3 class="h6 mb-0">
                        <i class="bi bi-upload me-2"></i>
                        Import Status
                    </h3>
                    <span class="badge bg-info" id="transaction-counter">
                        Processing: 0 of {{ total_num_transactions }} transactions
                    </span>
                </div>
                
                <div class="progress mb-4" style="height: 2rem;">
                    <div class="progress-bar progress-bar-striped progress-bar-animated bg-gradient bg-success" 
                         role="progressbar" 
                         style="width: 0%;" 
                         id="progressBar"
                         aria-valuenow="0" 
                         aria-valuemin="0" 
                         aria-valuemax="100">
                        <span class="progress-bar-text ms-2">
                            <span id="progress-percentage">0</span>%
                        </span>
                    </div>
                </div>
                
                <div class="row mb-4">
                    <div class="col-md-6 mb-3">
                        <div class="card bg-light">
                            <div class="card-body">
                                <h6 class="card-title text-success">
                                    <i class="bi bi-check-circle-fill me-2"></i>
                                    Success
                                </h6>
                                <p class="card-text h4 text-success" id="success-count">0</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <div class="card bg-light">
                            <div class="card-body">
                                <h6 class="card-title text-warning">
                                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                    Warnings
                                </h6>
                                <p class="card-text h4 text-warning" id="warning-count">0</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <div id="logs-container" class="mb-4">
                <h5 class="h6 mb-3">
                    <i class="bi bi-journal-text me-2"></i>
                    Import Log
                </h5>
                <div class="bg-light p-3 rounded">
                    <div id="log-content" class="small" style="max-height: 200px; overflow-y: auto;">
                        <div class="text-muted mb-2"><em>Starting import process...</em></div>
                        <div class="text-muted mb-2"><em>Connecting to bank server...</em></div>
                    </div>
                </div>
            </div>
            
            <form name="next-form" action="." method="post" id="continueForm">
                <input type="hidden" name="step" value="{{ next_step }}">
                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-primary" id="continueButton" disabled>
                        <i class="bi bi-play-fill me-1"></i>
                        Continue Import
                    </button>
                    <div class="text-center mt-3">
                        <small class="text-muted">
                            The import will continue automatically, but you can wait for completion here.
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
{% endblock %}

{% block extra_js %}
<script>
    document.addEventListener('DOMContentLoaded', function() {
        // WebSocket connection for real-time updates
        let socket = null;
        let pollInterval = null;
        
        // Initialize WebSocket or polling based on available connection
        try {
            // Try WebSocket first
            socket = new WebSocket('{{ websocketUrl }}');
            
            socket.onmessage = function(event) {
                const data = JSON.parse(event.data);
                updateImportStatus(data);
            };
            
            socket.onerror = function(error) {
                console.error('WebSocket error:', error);
                fallbackToPolling();
            };
            
            socket.onclose = function() {
                fallbackToPolling();
            };
        } catch (e) {
            // Fallback to polling
            fallbackToPolling();
        }
        
        function fallbackToPolling() {
            pollInterval = setInterval(function() {
                fetch('/api/progress')
                    .then(response => response.json())
                    .then(data => updateImportStatus(data))
                    .catch(error => console.error('Polling error:', error));
            }, 3000);
        }
        
        function updateImportStatus(data) {
            if (!data) return;
            
            // Update progress bar
            const progressBar = document.getElementById('progressBar');
            const progressText = document.getElementById('progress-percentage');
            const transactionCounter = document.getElementById('transaction-counter');
            const successCount = document.getElementById('success-count');
            const warningCount = document.getElementById('warning-count');
            
            if (progressBar && progressText) {
                const percentage = Math.min(100, Math.round((data.processed || 0) / (data.total || 1) * 100));
                progressBar.style.width = percentage + '%';
                progressBar.setAttribute('aria-valuenow', percentage);
                progressText.textContent = percentage;
            }
            
            if (transactionCounter) {
                transactionCounter.textContent = `Processing: ${data.processed || 0} of ${data.total || 0}`;
            }
            
            if (successCount) {
                successCount.textContent = data.success || 0;
            }
            
            if (warningCount) {
                warningCount.textContent = data.warnings || 0;
            }
            
            // Update logs
            const logContent = document.getElementById('log-content');
            if (data.message && logContent) {
                const timestamp = new Date().toLocaleTimeString();
                const logLine = document.createElement('div');
                logLine.className = 'text-break mb-1';
                logLine.innerHTML = `[${timestamp}] ${data.message}`;
                
                logContent.insertBefore(logLine, logContent.firstChild);
                
                if (logContent.children.length > 100) {
                    logContent.lastChild.remove();
                }
            }
            
            // Enable continue button when complete
            const continueButton = document.getElementById('continueButton');
            if (continueButton) {
                if (data.completed) {
                    continueButton.disabled = false;
                    continueButton.innerHTML = '<i class="bi bi-check-circle-fill me-1"></i> Import Complete';
                    clearInterval(pollInterval);
                    if (socket) socket.close();
                }
            }
        }
        
        // Form submission handling
        const continueForm = document.getElementById('continueForm');
        if (continueForm) {
            continueForm.addEventListener('submit', function(e) {
                e.preventDefault();
                const button = this.querySelector('button');
                button.disabled = true;
                button.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Processing...';
                this.submit();
            });
        }
        
        // Auto-hide logs after 30 seconds
        setTimeout(function() {
            const logContent = document.getElementById('log-content');
            if (logContent) {
                logContent.style.opacity = '0.5';
                logContent.title = 'Click to show/hide logs';
            }
        }, 30000);
    });
</script>
{% endblock %}