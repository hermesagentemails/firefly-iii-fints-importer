{% extends 'base.twig' %}

{% block title %}Collecting Data{% endblock %}

{% block content %}
    <div class="card">
        <div class="card-header">
            <h2 class="h5 mb-0">
                <i class="bi bi-arrow-down-circle-fill me-2"></i>
                Collecting data from your bank
            </h2>
        </div>
        <div class="card-body">
            {% if configuration is not empty %}
                <div class="mb-4">
                    <h5 class="h6 mb-2">
                        <i class="bi bi-info-circle me-1"></i>
                        Status
                    </h5>
                    <div class="bg-light p-3 rounded">
                        <p class="mb-2"><strong>Bank:</strong> {{ configuration.bank_username }}</p>
                        {% if configuration.bank_url %}
                            <p class="mb-2"><strong>Bank URL:</strong> <code class="bg-white p-1 rounded">{{ configuration.bank_url }}</code></p>
                        {% endif %}
                        {% if configuration.account_iban %}
                            <p class="mb-0"><strong>Account IBAN:</strong> <code class="bg-white p-1 rounded">{{ configuration.account_iban }}</code></p>
                        {% endif %}
                    </div>
                </div>
            {% endif %}

            {% if not results.empty %}
                <div class="alert alert-success" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i>
                    Successfully retrieved account data!
                </div>
                
                <div class="mb-4">
                    <h5 class="h6 mb-2">
                        <i class="bi bi-piggy-bank-fill me-1"></i>
                        Accounts Found
                    </h5>
                    <div class="list-group">
                        {% for index, account in accounts %}
                            <a href="#" class="list-group-item list-group-item-action {% if loop.first %}active{% endif %}" data-index="{{ index }}">
                                <div class="d-flex w-100 justify-content-between">
                                    <h6 class="mb-1">{{ account.subAccount }}</h6>
                                    <small class="text-muted">{{ account.accountNumber }}</small>
                                </div>
                                <p class="mb-1">
                                    {% if account.iban %}<strong>IBAN:</strong> {{ account.iban }}<br>{% endif %}
                                    {% if account.bic %}<strong>BIC:</strong> {{ account.bic }}<br>{% endif %}
                                    <small>Balance: {{ account.balance|default('0.00') }} {{ account.currency|default('EUR') }}</small>
                                </p>
                            </a>
                        {% endfor %}
                    </div>
                    <input type="hidden" name="selected_account_index" id="selected_account_index" value="0">
                </div>
            {% endif %}

            {% if configuration.account_iban == "" and accounts|length > 0 %}
                <div class="mb-4">
                    <h5 class="h6 mb-2">
                        <i class="bi bi-list-check me-1"></i>
                        Select Account
                    </h5>
                    <div class="mb-3">
                        <div class="form-floating">
                            <select class="form-select" id="account_select" aria-label="Account selection">
                                {% for index, account in accounts %}
                                    <option value="{{ index }}">
                                        {% if account.iban %}{{ account.iban }} &mdash; {% endif %}
                                        {{ account.subAccount }}, {{ account.accountNumber }}
                                    </option>
                                {% endfor %}
                            </select>
                            <label for="account_select">Choose your account</label>
                        </div>
                        <div class="form-text">
                            Select the bank account you wish to import transactions from.
                        </div>
                    </div>
                </div>
            {% endif %}

            <form name="next-form" action="." method="post" id="collectForm">
                <input type="hidden" name="step" value="{{ next_step }}">
                
                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-primary">
                        {% if configuration.account_iban == "" and accounts|length > 0 %}
                            <i class="bi bi-check-circle me-1"></i>Continue to next step
                        {% else %}
                            <i class="bi bi-arrow-right-circle me-1"></i>Proceed
                        {% endif %}
                    </button>
                </div>
            </form>
        </div>
    </div>
{% endblock %}

{% block extra_js %}
<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Handle account selection
        const accountSelect = document.getElementById('account_select');
        const selectedAccountInput = document.getElementById('selected_account_index');
        const collectForm = document.getElementById('collectForm');
        
        if (accountSelect && selectedAccountInput) {
            accountSelect.addEventListener('change', function() {
                selectedAccountInput.value = this.value;
            });
            
            // Auto-select first account if exists
            if (accountSelect.options.length > 0 && selectedAccountInput.value === '') {
                accountSelect.value = 0;
                selectedAccountInput.value = 0;
            }
        }
        
        // Form validation
        collectForm.addEventListener('submit', function(e) {
            const accountSelect = document.getElementById('account_select');
            if (accountSelect && accountSelect.value === '' && 
                document.querySelector('[name="data_collect_mode"]').value === 'createNewDataset') {
                e.preventDefault();
                alert('Please select an account or choose to create a new configuration');
            }
        });
    });
</script>
{% endblock %}