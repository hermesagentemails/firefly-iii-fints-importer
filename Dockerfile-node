# Dockerfile-node - Multi-stage build for modern frontend
FROM node:18.18.2-alpine AS builder

# Set working directory
WORKDIR /app

# Copy package files
COPY package*.json ./

# Install ALL dependencies
# Use --legacy-peer-deps to resolve esbuild version conflicts
RUN npm install --legacy-peer-deps

# Copy source files
COPY . .

# Create vite.config.js if it doesn't exist
RUN if [ ! -f vite.config.js ]; then \
    echo "import { defineConfig } from 'vite';" > vite.config.js && \
    echo "" >> vite.config.js && \
    echo "export default defineConfig({" >> vite.config.js && \
    echo "  server: {" >> vite.config.js && \
    echo "    host: '0.0.0.0'," >> vite.config.js && \
    echo "    port: 3000" >> vite.config.js && \
    echo "  }" >> vite.config.js && \
    echo "});" >> vite.config.js; \
    fi

# Build for production
RUN mkdir -p dist && cp -r app/public/html dist/ 2>/dev/null || true

# Development stage
FROM node:18.18.2-alpine AS dev

# Set working directory
WORKDIR /app

# Copy all files including package.json
COPY --from=builder /app/package*.json ./
COPY --from=builder /app/node_modules ./node_modules
COPY . .

# Install all dependencies
# Use --legacy-peer-deps to resolve esbuild version conflicts
RUN npm install --legacy-peer-deps

# Expose port
EXPOSE 3000

# Start dev server
CMD npm run dev